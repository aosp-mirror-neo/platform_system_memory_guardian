package: "android.memory.guardian.flags"
container: "system"

flag {
  name: "memory_guardian_enabled"
  namespace: "system_performance"
  description: "This flag controls whether Process Memory Guardian Daemon is enabled"
  bug: "434681786"
}

flag {
  name: "memory_guardian_uses_vendor_config"
  namespace: "system_performance"
  description: "This flag controls whether PMGD uses a vendor config to monitor procesess"
  bug: "469171835"
}

flag {
  name: "process_kill_enabled"
  namespace: "system_performance"
  description: "All pmgd to kill a process on memory.high events"
  bug: "434681786"
}

flag {
  name: "heap_dump_enabled"
  namespace: "system_performance"
  description: "Allow pmgd to take heap dumps"
  bug: "496121052"
}
