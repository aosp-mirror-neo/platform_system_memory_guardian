package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "pmgd_defaults",
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "liblogger",
        "liblog_rust",
        "libnix",
        "libpmgd_flags_rust",
        "librustutils",
    ],
}

aconfig_declarations {
    name: "pmgd_flags",
    package: "android.memory.guardian.flags",
    container: "system",
    srcs: ["flags.aconfig"],
}

rust_aconfig_library {
    name: "libpmgd_flags_rust",
    crate_name: "pmgd_flags",
    aconfig_declarations: "pmgd_flags",
}

rust_binary {
    name: "pmg_daemon",
    defaults: ["pmgd_defaults"],
    stem: "pmgd",
    init_rc: ["pmgd.rc"],
}
