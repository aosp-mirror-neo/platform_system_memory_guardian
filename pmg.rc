service pmg /system/bin/pmg
    class core
    user pmg
    group pmg
    disabled

on property:sys.boot_completed=1
    # pmg service starts only if AConfig flag is enabled when boot_completed.
    exec /system/bin/pmg --set-property

on property:pmg.enabled_aconfig=true
    # Enable pmg daemon if the system property copied from AConfig flag by
    # "/system/bin/pmg --set-property" is enabled.
    enable pmg
